{
  "name": "vue-cropgram",
  "version": "2.0.0",
  "description": "Instagram Style Image Uploader for Vue",
  "type": "commonjs",
  "main": "./dist/vue-cropgram.umd.js",
  "unpkg": "./dist/vue-cropgram.umd.js",
  "module": "./dist/vue-cropgram.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/vue-cropgram.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-cropgram.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "private": false,
  "scripts": {
    "build:dist": "vite build --mode dist",
    "build:demo": "vite build --mode demo",
    "build": "npm run build:dist && npm run build:demo",
    "lint": "eslint .",
    "test": "vitest run && npm run test:types",
    "test:types": "tsc -p tests/types",
    "prepack": "npm run build:dist"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avidofood/vue-cropgram.git"
  },
  "bugs": {
    "url": "https://github.com/avidofood/vue-cropgram/issues"
  },
  "homepage": "https://avidofood.github.io/vue-cropgram/",
  "keywords": [
    "vue 3",
    "vue3",
    "vue",
    "instagram",
    "image uploader",
    "image upload",
    "multiple images",
    "cropper",
    "image cropper",
    "crop",
    "typescript"
  ],
  "author": {
    "name": "Philipp Mochine",
    "email": "support@avidofood.com",
    "url": "https://avidofood.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "dependencies": {
    "vue-instagram-cropper": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-avidofood": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
